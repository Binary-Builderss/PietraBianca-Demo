---
import '../styles/global.css';
import type { DivisioneId } from '../lib/contatti';
import Nav from '../components/Nav.astro';
import Tabbar from '../components/Tabbar.astro';
import PrenotaSheet from '../components/PrenotaSheet.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  divisione?: DivisioneId;
  navTheme?: 'dark' | 'light';
}
const { title, description, divisione, navTheme = 'dark' } = Astro.props;
---
<!doctype html>
<html lang="it" data-divisione={divisione}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0B1F3A" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Salta al contenuto</a>
    <Nav divisione={divisione} navTheme={navTheme} />
    <main id="main"><slot /></main>
    <Footer />
    <Tabbar divisione={divisione} />
    {!divisione && <PrenotaSheet />}
  </body>
</html>
