---
import '../styles/global.css';
import type { DivisioneId } from '../lib/contatti';
import Nav from '../components/Nav.astro';
import Tabbar from '../components/Tabbar.astro';
import PrenotaSheet from '../components/PrenotaSheet.astro';
import Footer from '../components/Footer.astro';
// font del primo schermo in preload: evita il cambio font dopo il primo paint (e il loader della home aspetta document.fonts.ready)
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import bodoni from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';
import bodoniItalic from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-italic.woff2?url';

interface Props {
  title: string;
  description: string;
  divisione?: DivisioneId;
  navTheme?: 'dark' | 'light';
}
const { title, description, divisione, navTheme = 'dark' } = Astro.props;
---
<!doctype html>
<html lang="it" data-divisione={divisione}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0B1F3A" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {[manrope, bodoni, bodoniItalic].map(href => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Salta al contenuto</a>
    <Nav divisione={divisione} navTheme={navTheme} />
    <slot name="fixed" />
    <!-- ScrollSmoother (home, desktop): solo il flusso della pagina; nav, tabbar e loader restano fuori, fissi -->
    <div id="smooth-wrapper"><div id="smooth-content">
      <main id="main"><slot /></main>
      <Footer />
    </div></div>
    <Tabbar divisione={divisione} />
    {!divisione && <PrenotaSheet />}
  </body>
</html>
