---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PaginaDivisione from '../components/PaginaDivisione.astro';
import { waLink, type Divisione } from '../lib/contatti';

const piscina = (await getCollection('divisioni')).map(e => e.data as Divisione).find(d => d.id === 'piscina')!;
// DA CONFERMARE: numero WhatsApp piscina (la collezione punta al numero SPA)
const info = waLink(piscina.whatsapp, piscina.waTesto);

// foto fuori da git: si leggono con la glob, nessun import statico
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/cliente/*', { eager: true });
const tramonto = files['/src/assets/cliente/pool-sunset-lounge.jpg']?.default;
if (!tramonto) throw new Error('Foto mancante: src/assets/cliente/pool-sunset-lounge.jpg (lancia npm run foto)');

const food = ['Panini', 'Insalate', 'Pasta', 'Zingare', 'Gluten free'];
const ND = '[DA INSERIRE CON IL CLIENTE]';
const faq = [
  { d: 'Serve prenotare?', r: 'No, in piscina non si prenota: si entra fino a esaurimento posti.' },
  { d: 'Il lettino è incluso?', r: 'Sì, il lettino è compreso nell’ingresso*.' },
  { d: 'E l’ombrellone?', r: `L’ombrellone è su richiesta. Costo: ${ND}` },
  { d: 'Posso portare da mangiare?', r: `No, è vietato. C’è l’area food: ${food.join(', ').toLowerCase()}.` },
  { d: 'Posso portare la borsa frigo?', r: ND },
  { d: 'Come funziona l’ingresso per i bambini?', r: `Ingresso e altezza: ${ND}` },
  { d: 'Quando è aperta?', r: 'Tutti i giorni dalle 9:00 alle 18:00 in stagione. Si apre dal 30 maggio, tutti i giorni dal 15 giugno.' },
];
---
<Base title="Piscina · Pietrabianca Resort" description="Tre piscine, lettini al sole e un'area food: orari, listino e regolamento del day-use." divisione="piscina">
  <PaginaDivisione id="piscina" titolo="Tre piscine," titoloEm="un’estate intera." intro="Lettini al sole e un’area food per restare dal mattino a sera." foto="pool-parasol-sunbed.jpg" fotoAlt={piscina.fotoAlt} focus="50% 70%">

    <section class="pi-sez" data-theme="light" aria-labelledby="listinoT">
      <div data-reveal>
        <h2 class="font-display" id="listinoT">Una giornata, <em>il lettino incluso.</em></h2>
        <p class="pi-nota">Il lettino è incluso. L’ombrellone è su richiesta.</p>
        <p class="pi-nota pi-nota-s">*Prezzi indicativi, da confermare</p>
        <a class="btn btn-wa" href={info}>{piscina.prenota.label}</a>
      </div>
      <dl class="pi-prezzi" data-reveal>
        <div><dt>Giorni feriali</dt><dd class="font-display">€13<span class="ast">*</span></dd></div>
        <div><dt>Weekend</dt><dd class="font-display">€18<span class="ast">*</span></dd></div>
      </dl>
    </section>

    <section class="pi-sez pi-trav" data-theme="light" aria-labelledby="regoleT">
      <div class="pi-pic" data-reveal><Image src={tramonto} alt="Divano a bordo piscina al tramonto, con una lampada accesa" widths={[480, 800]} sizes="(min-width: 821px) 40vw, 100vw" /></div>
      <div data-reveal>
        <p class="eyebrow">Orari e regole</p>
        <h2 class="font-display" id="regoleT">Si entra, <em>ci si tuffa.</em></h2>
        <ul class="pi-lista">
          <li><strong>Orari</strong> Tutti i giorni 9:00–18:00 in stagione. Apre il 30 maggio, tutti i giorni dal 15 giugno.</li>
          <li><strong>Prenotazioni</strong> Non si prenota: si entra fino a esaurimento posti.</li>
          <li><strong>Cibo</strong> È vietato introdurre cibo dall’esterno.</li>
          <li><strong>Bambini</strong> Ingresso e altezza: {ND}</li>
        </ul>
      </div>
    </section>

    <section class="pi-sez pi-notte" data-theme="dark" aria-labelledby="foodT">
      <div data-reveal>
        <h2 class="font-display" id="foodT">Si mangia <em>a bordo piscina.</em></h2>
      </div>
      <ul class="pi-food" data-reveal>{food.map(f => <li>{f}</li>)}</ul>
    </section>

    <section class="pi-sez pi-col" data-theme="light" aria-labelledby="faqT">
      <div data-reveal>
        <h2 class="font-display" id="faqT">Prima di <em>partire.</em></h2>
      </div>
      <div class="pi-faq" data-reveal>
        {faq.map(f => <details><summary>{f.d}</summary><p>{f.r}</p></details>)}
      </div>
    </section>

  </PaginaDivisione>
</Base>

<script>
  import { initMotion } from '../scripts/motion';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  initMotion({ reduce, desktop: matchMedia('(min-width: 821px) and (hover: hover) and (pointer: fine)').matches });
</script>

<style is:global>
  .pi-sez { display: grid; gap: 40px; padding: var(--sec-y) var(--gut); color: var(--notte); }
  .pi-trav { background: var(--trav); }
  .pi-notte { background: var(--notte); color: #fff; }
  .pi-sez h2 { max-width: 18ch; }
  .pi-sez .eyebrow { color: var(--navy); }
  .pi-notte h2 em { color: var(--azz); }
  .pi-nota { margin: 0 0 16px; max-width: 44ch; font-size: 15px; line-height: 1.6; }
  .pi-nota-s { font-size: 13px; margin-bottom: 24px; }
  .pi-prezzi { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-content: center; }
  .pi-prezzi div { padding: 24px 0; border-top: 1px solid rgba(6, 54, 109, .35); }
  .pi-prezzi dt { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; color: var(--navy); }
  .pi-prezzi dd { margin: 10px 0 0; font-size: clamp(44px, 6vw, 80px); line-height: 1; font-weight: 500; }
  .pi-prezzi .ast { font: 600 .32em var(--font-sans); vertical-align: super; margin-left: .1em; }
  .pi-pic { aspect-ratio: 4/5; max-width: 520px; overflow: hidden; border-radius: 6px; }
  .pi-pic img { width: 100%; height: 100%; object-fit: cover; }
  .pi-lista { list-style: none; margin: 0; padding: 0; }
  .pi-lista li { padding: 14px 0; border-top: 1px solid rgba(6, 54, 109, .25); font-size: 16px; line-height: 1.5; }
  .pi-lista strong { display: block; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--navy); margin-bottom: 4px; }
  .pi-food { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; align-content: start; }
  .pi-food li { padding: 10px 18px; border: 1px solid var(--azz); border-radius: 999px; font-size: 16px; }
  .pi-faq { max-width: 720px; }
  .pi-faq details { border-top: 1px solid rgba(6, 54, 109, .25); }
  .pi-faq details:last-child { border-bottom: 1px solid rgba(6, 54, 109, .25); }
  .pi-faq summary { display: flex; justify-content: space-between; gap: 16px; padding: 18px 0; font-size: 17px; font-weight: 600; cursor: pointer; list-style: none; }
  .pi-faq summary::-webkit-details-marker { display: none; }
  .pi-faq summary::after { content: '+'; font-size: 22px; line-height: 1; color: var(--navy); }
  .pi-faq details[open] summary::after { content: '–'; }
  .pi-faq p { margin: 0 0 20px; max-width: 52ch; font-size: 15px; line-height: 1.6; }
  @media (min-width: 821px) {
    .pi-sez:not(.pi-col):not(.pi-notte) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 6vw, 96px); }
    .pi-notte { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 6vw, 96px); }
  }
</style>
