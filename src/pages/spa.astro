---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PaginaDivisione from '../components/PaginaDivisione.astro';
import massaggio from '../assets/cliente/spa-face-massage.jpg';
import { waLink, type Divisione } from '../lib/contatti';

const spa = (await getCollection('divisioni')).map(e => e.data as Divisione).find(d => d.id === 'spa')!;
const wa = (testo: string) => waLink(spa.whatsapp, testo);
const servizi = ['Sauna finlandese', 'Bagno turco', 'Vasca idromassaggio, con piscina SPA riscaldata', 'Docce emozionali', 'Cascata di ghiaccio', 'Cromoterapia', 'Area relax con mosaici artistici', 'Tisane e frutta'];
const massaggi = ['Massaggio Maori', 'Massaggio al sale', 'Massaggio rilassante', 'Massaggio di coppia', 'Tranquility Ritual'];
// una riga descrittiva ciascuna, nessuna promessa di risultato (BRAND_IDENTITY §3.2)
const tecnologie = [
  { nome: 'KRONOS', riga: 'Tecnologia Tesla Med per prendersi cura di viso e corpo.' },
  { nome: 'B-Tonic', riga: 'Tecnologia che lavora in modo simultaneo su muscolo e tessuto adiposo.' },
  { nome: 'Slim Swing', riga: 'Massaggio vibrante che stimola l’ossigenazione dei tessuti.' },
];
---
<Base title="SPA · Pietrabianca Resort" description="Pietrabianca Space: percorso SPA, massaggi e tecnologie di estetica avanzata." divisione="spa">
  <PaginaDivisione id="spa" titolo="Nessuna fretta." intro="Lascia fuori ansia e frenesia: qui ci sono acqua calda, luci soffuse e silenzi che rigenerano." foto="v3-spa-hydromassage.jpg" fotoAlt={spa.fotoAlt} focus="50% 80%">

    <section class="spa-sez" data-theme="light" aria-labelledby="percorsoT">
      <div data-reveal>
        <p class="eyebrow">Percorso SPA</p>
        <h2 class="font-display" id="percorsoT">Acqua calda, <em>luci soffuse.</em></h2>
        <p class="spa-prezzo">€35 di listino, in promo da €15 (kit escluso)*</p>
        <p class="spa-nota">Perfetto per un girls day, un compleanno o un addio al nubilato.</p>
        <a class="btn btn-wa" href={wa(spa.waTesto)}>Prenota il percorso</a>
      </div>
      <ul class="spa-lista" data-reveal>{servizi.map(s => <li>{s}</li>)}</ul>
    </section>

    <section class="spa-sez spa-trav" data-theme="light" aria-labelledby="massaggiT">
      <div class="spa-pic" data-reveal><Image src={massaggio} alt="Massaggio alla testa durante un trattamento" widths={[480, 800]} sizes="(min-width: 821px) 40vw, 100vw" /></div>
      <div data-reveal>
        <p class="eyebrow">Massaggi</p>
        <h2 class="font-display" id="massaggiT">Mani lente, <em>pensieri leggeri.</em></h2>
        <ul class="spa-lista spa-1">{massaggi.map(m => <li>{m}</li>)}</ul>
        <p class="spa-nota">Durate e listino: [DA INSERIRE CON IL CLIENTE]</p>
        <a class="btn btn-navy" href={wa('Vorrei informazioni sui massaggi')}>Chiedi dei massaggi</a>
      </div>
    </section>

    <section class="spa-sez spa-col" data-theme="light" aria-labelledby="tecnoT">
      <div data-reveal>
        <p class="eyebrow">Tecnologie</p>
        <h2 class="font-display" id="tecnoT">Estetica avanzata, <em>con calma.</em></h2>
      </div>
      <div class="spa-tecno">
        {tecnologie.map(t => (
          <article data-reveal>
            <h3 class="font-display">{t.nome}</h3>
            <p>{t.riga}</p>
            <a class="btn btn-navy" href={wa(`Vorrei informazioni sul trattamento ${t.nome}`)}>Chiedi di {t.nome}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="spa-sez spa-notte" data-theme="dark" aria-labelledby="pacchettoT">
      <div data-reveal>
        <p class="eyebrow">Pacchetto</p>
        <h2 class="font-display" id="pacchettoT">Percorso SPA + Menu di coppia <em>al Ristorante Don Peppino</em></h2>
        <p class="spa-nota">Percorso SPA e menu di coppia da Don Peppino, insieme.</p>
        <p class="spa-prezzo">Prezzo: [DA INSERIRE CON IL CLIENTE]</p>
        <a class="btn btn-wa" href={wa('Vorrei informazioni sul pacchetto Percorso SPA + Menu di coppia al Ristorante Don Peppino')}>Chiedi il pacchetto</a>
      </div>
    </section>

  </PaginaDivisione>
</Base>

<script>
  import { initMotion } from '../scripts/motion';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  initMotion({ reduce, desktop: matchMedia('(min-width: 821px) and (hover: hover) and (pointer: fine)').matches });
</script>

<style is:global>
  .spa-sez { display: grid; gap: 40px; padding: clamp(64px, 11vh, 112px) clamp(16px, 4vw, 48px); color: var(--notte); }
  .spa-trav { background: var(--trav); }
  .spa-notte { background: var(--notte); color: #fff; }
  .spa-sez h2 { margin: 8px 0 20px; font-size: clamp(32px, 3.6vw, 56px); line-height: 1.05; font-weight: 500; max-width: 18ch; }
  .spa-sez h2 em { font-style: italic; font-weight: 400; }
  .spa-sez .eyebrow { color: var(--navy); }
  .spa-notte .eyebrow, .spa-notte h2 em { color: var(--azz); }
  .spa-prezzo { margin: 0 0 12px; font-size: 18px; font-weight: 700; }
  .spa-nota { margin: 0 0 24px; max-width: 44ch; font-size: 15px; line-height: 1.6; }
  .spa-lista { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 0 32px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); align-content: start; }
  .spa-lista li { padding: 14px 0; border-top: 1px solid rgba(6, 54, 109, .25); font-size: 16px; }
  .spa-1 { grid-template-columns: 1fr; }
  .spa-pic { aspect-ratio: 4/5; max-width: 520px; overflow: hidden; border-radius: 6px; }
  .spa-pic img { width: 100%; height: 100%; object-fit: cover; }
  .spa-tecno { display: grid; gap: 32px; }
  .spa-tecno article { padding-top: 24px; border-top: 1px solid rgba(6, 54, 109, .35); }
  .spa-tecno h3 { margin: 0 0 10px; font-size: 28px; font-weight: 500; }
  .spa-tecno p { margin: 0 0 20px; max-width: 34ch; font-size: 15px; line-height: 1.6; }
  @media (min-width: 821px) {
    .spa-sez:not(.spa-col):not(.spa-notte) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 6vw, 96px); }
    .spa-tecno { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 56px); }
  }
</style>
