---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import heroFoto from '../../assets/cliente/hero.jpg';
import { waLink, type Divisione } from '../../lib/contatti';

const spa = (await getCollection('divisioni')).map(e => e.data as Divisione).find(d => d.id === 'spa')!;
// su mobile: WebP 1040 px (nitido su schermi DPR 2-3) invece del JPEG, che resta per desktop e per la texture WebGL
const heroMobile = await getImage({ src: heroFoto, format: 'webp', width: 1040, quality: 75 });
---
<section class="hero" id="hero" data-theme="dark">
  <div class="hero-media" id="heroMedia"><div class="layer" id="heroLayer">
    <picture>
      <source media="(max-width: 820px)" srcset={heroMobile.src} type="image/webp" />
      <img src="/cliente/hero.jpg" width="1040" height="1920" alt="La piscina del Pietrabianca al tramonto, vista dal divanetto a bordo vasca" id="heroImg" fetchpriority="high" />
    </picture>
  </div></div>
  <div class="hero-txt">
    <p class="kicker" id="kicker">Pomigliano d’Arco · a 20 minuti da Napoli</p>
    <h1 class="font-display" id="title"><span class="l1">Tre anime,</span> <span class="l2">una sola destinazione.</span></h1>
    <div class="ctas" id="ctas">
      <a href={spa.href} class="btn btn-white" id="primaryCta">Scopri la SPA</a>
      <a href={waLink(spa.whatsapp, spa.waTesto)} class="txtlink">o scrivici su WhatsApp →</a>
    </div>
  </div>
</section>

<style is:global>
  /* v4: tramonto verticale. Mobile a tutto schermo; desktop = finestra verticale nel campo notte (foto 1040×1920) */
  .hero { position: relative; height: 100svh; min-height: 560px; overflow: hidden; background: var(--notte); --g: clamp(16px, 4vw, 48px); --top: 96px; --ww: min(calc((100svh - var(--top) - var(--g)) * .6), 42vw); }
  .hero-media { position: absolute; inset: 0; overflow: hidden; }
  .hero-media .layer { position: absolute; inset: 0; }
  .hero-media img, .hero-media canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 12% 60%; }
  .hero-media.gl img { visibility: hidden; }
  .hero:after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, transparent 46%, rgba(11, 31, 58, .45) 64%, rgba(11, 31, 58, .9) 100%); }
  .hero-txt { position: absolute; z-index: 2; left: clamp(16px, 4vw, 48px); right: clamp(16px, 4vw, 48px); bottom: clamp(56px, 9vh, 96px); color: #fff; }
  .kicker { margin: 0; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; }
  .hero h1 { margin: 16px 0 28px; line-height: 1; font-weight: 500; }
  .hero h1 .l1 { display: block; font-size: clamp(44px, 7vw, 112px); letter-spacing: .02em; text-transform: uppercase; }
  .hero h1 .l2 { display: block; font-size: clamp(28px, 4.2vw, 67px); font-style: italic; font-weight: 400; letter-spacing: -.01em; margin-top: .1em; }
  .hero h1 .line-mask { padding: .08em 0 .16em; margin: -.08em 0 -.16em; }
  .ctas { display: flex; gap: 22px; flex-wrap: wrap; align-items: center; }
  .txtlink { font-weight: 600; font-size: 14px; border-bottom: 1px solid rgba(255, 255, 255, .6); padding: 12px 0 2px; }
  @media (min-width: 821px) {
    .hero-media { inset: var(--top) var(--g) var(--g) auto; width: var(--ww); border-radius: 6px; }
    /* tenere allineato con origin [.5, .72] passato a initWater */
    .hero-media img, .hero-media canvas { object-position: 50% 72%; }
    .hero:after { display: none; }
    .hero-txt { right: calc(var(--ww) + var(--g) + clamp(24px, 4vw, 64px)); bottom: var(--g); }
    /* niente font-size desktop dedicati: nella v4 approvata erano scavalcati dall'ordine delle regole (resta 7vw / 4.2vw) */
  }
  @media (max-width: 820px) {
    .hero-txt { bottom: calc(96px + env(safe-area-inset-bottom)); }
  }
</style>
