---
const MAPS = "https://www.google.com/maps/search/?api=1&query=Via+Pratola+Ponte+80+Pomigliano+d'Arco";
---
<!-- mappa statica: nessun iframe né richiesta a Google finché non si clicca (GDPR). Notte come il footer: un solo blocco finale -->
<section class="mappa" id="dove" data-theme="dark" aria-labelledby="mappaTitle">
  <h2 class="font-display" id="mappaTitle"><em>Ti aspettiamo.</em></h2>
  <div class="mappa-box" data-reveal>
    <address>Via Pratola Ponte 80<br />80038 Pomigliano d'Arco (NA)<br /><span>A 20 minuti da Napoli · parcheggio gratuito</span></address>
    <a class="btn btn-white" href={MAPS} target="_blank" rel="noopener">Apri in Google Maps</a>
  </div>
</section>

<style is:global>
  .mappa { padding: var(--sec-y) var(--gut) 48px; background: var(--notte); color: #fff; }
  .mappa h2 { font-size: clamp(48px, 7vw, 112px); line-height: 1.02; padding-bottom: .08em; }
  .mappa-box { display: grid; gap: 24px; margin-top: 40px; justify-items: start; }
  .mappa address { font-style: normal; font-size: 17px; line-height: 1.6; font-weight: 600; }
  .mappa address span { font-weight: 400; font-size: 14px; opacity: .85; }
  @media (min-width: 821px) { .mappa-box { grid-template-columns: minmax(0, 1fr) auto; align-items: end; } }
</style>
