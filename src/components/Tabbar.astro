---
import { getCollection } from 'astro:content';
import { CENTRALINO, prenotaAction, telLink, waLink, type Divisione, type DivisioneId } from '../lib/contatti';

interface Props { divisione?: DivisioneId }
const { divisione } = Astro.props;

const tutte = (await getCollection('divisioni')).map(e => e.data as Divisione);
const corrente = tutte.find(d => d.id === divisione);
// home: WhatsApp = SPA, Chiama = centralino, Prenota = foglio con le 4 divisioni
const wa = corrente ?? tutte.find(d => d.id === 'spa')!;
const tel = corrente ? corrente.tel : CENTRALINO;
const prenota = corrente && prenotaAction(corrente);
---
<nav class="tabbar" aria-label="Contatti rapidi">
  <a class="w" href={waLink(wa.whatsapp, wa.waTesto)}>WhatsApp</a>
  <a href={telLink(tel)}>Chiama</a>
  {prenota
    ? <a class="p" href={prenota.href}>{prenota.label}</a>
    : <button type="button" class="p" aria-controls="prenota" aria-haspopup="dialog">Prenota</button>}
</nav>

<style is:global>
  .tabbar { position: fixed; z-index: 60; left: max(10px, env(safe-area-inset-left)); right: max(10px, env(safe-area-inset-right)); bottom: max(10px, env(safe-area-inset-bottom)); display: none; grid-template-columns: 1fr 1fr 1fr; gap: 6px; padding: 6px; border-radius: 20px; background: rgba(255, 255, 255, .62); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); border: 1px solid rgba(255, 255, 255, .5); box-shadow: 0 8px 30px rgba(0, 0, 0, .18); }
  .tabbar a, .tabbar button { display: flex; align-items: center; justify-content: center; min-height: 48px; border: 0; border-radius: 14px; background: none; font: 700 14px 'Manrope Variable', sans-serif; color: var(--navy); cursor: pointer; -webkit-tap-highlight-color: transparent; transition: transform .1s ease-out; }
  .tabbar a:active, .tabbar button:active { transform: scale(.96); }
  .tabbar .w { background: #25D366; color: #053; }
  .tabbar .p { background: var(--navy); color: #fff; }
  @media (prefers-reduced-transparency: reduce) { .tabbar { background: #fff; backdrop-filter: none; -webkit-backdrop-filter: none; } }
  @media (max-width: 820px) {
    .tabbar { display: grid; }
    footer.foot { padding-bottom: calc(48px + 76px + env(safe-area-inset-bottom)); } /* sotto il footer scuro non resta una fascia pietra */
  }
</style>
